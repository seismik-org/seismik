{
  "openapi": "3.1.0",
  "info": {
    "title": "Seismik Platform API",
    "version": "0.3.0"
  },
  "paths": {
    "/v1/events/candidate": {
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Ingest Candidate",
        "operationId": "ingest_candidate_v1_events_candidate_post",
        "parameters": [
          {
            "name": "X-Seismik-Timestamp",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Seismik-Timestamp"
            }
          },
          {
            "name": "X-Seismik-Signature",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Seismik-Signature"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$defs": {
                  "StationTrigger": {
                    "additionalProperties": false,
                    "properties": {
                      "provider_id": {
                        "title": "Provider Id",
                        "type": "string"
                      },
                      "country_code": {
                        "maxLength": 2,
                        "minLength": 2,
                        "title": "Country Code",
                        "type": "string"
                      },
                      "zone_id": {
                        "title": "Zone Id",
                        "type": "string"
                      },
                      "station_id": {
                        "title": "Station Id",
                        "type": "string"
                      },
                      "stream_id": {
                        "title": "Stream Id",
                        "type": "string"
                      },
                      "trigger_time": {
                        "format": "date-time",
                        "title": "Trigger Time",
                        "type": "string"
                      },
                      "received_at": {
                        "format": "date-time",
                        "title": "Received At",
                        "type": "string"
                      },
                      "sta_lta_ratio": {
                        "exclusiveMinimum": 0,
                        "title": "Sta Lta Ratio",
                        "type": "number"
                      },
                      "latitude": {
                        "anyOf": [
                          {
                            "maximum": 90,
                            "minimum": -90,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Latitude"
                      },
                      "longitude": {
                        "anyOf": [
                          {
                            "maximum": 180,
                            "minimum": -180,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Longitude"
                      },
                      "packet_lag_seconds": {
                        "anyOf": [
                          {
                            "minimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Packet Lag Seconds"
                      }
                    },
                    "required": [
                      "provider_id",
                      "country_code",
                      "zone_id",
                      "station_id",
                      "stream_id",
                      "trigger_time",
                      "received_at",
                      "sta_lta_ratio"
                    ],
                    "title": "StationTrigger",
                    "type": "object",
                    "x-product": "Seismik"
                  }
                },
                "additionalProperties": false,
                "properties": {
                  "event_id": {
                    "maxLength": 128,
                    "minLength": 1,
                    "title": "Event Id",
                    "type": "string"
                  },
                  "type": {
                    "const": "earthquake_candidate",
                    "title": "Type",
                    "type": "string"
                  },
                  "status": {
                    "const": "unlocated_unreviewed",
                    "title": "Status",
                    "type": "string"
                  },
                  "zone_id": {
                    "maxLength": 128,
                    "minLength": 1,
                    "title": "Zone Id",
                    "type": "string"
                  },
                  "country_code": {
                    "anyOf": [
                      {
                        "maxLength": 2,
                        "minLength": 2,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Country Code"
                  },
                  "country_codes": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "title": "Country Codes",
                    "type": "array"
                  },
                  "detected_at": {
                    "format": "date-time",
                    "title": "Detected At",
                    "type": "string"
                  },
                  "coincidence_window_seconds": {
                    "exclusiveMinimum": 0,
                    "title": "Coincidence Window Seconds",
                    "type": "number"
                  },
                  "required_stations": {
                    "minimum": 2,
                    "title": "Required Stations",
                    "type": "integer"
                  },
                  "station_count": {
                    "minimum": 2,
                    "title": "Station Count",
                    "type": "integer"
                  },
                  "stations": {
                    "items": {
                      "$ref": "#/$defs/StationTrigger"
                    },
                    "minItems": 2,
                    "title": "Stations",
                    "type": "array"
                  },
                  "estimated_latitude": {
                    "anyOf": [
                      {
                        "maximum": 90,
                        "minimum": -90,
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Estimated Latitude"
                  },
                  "estimated_longitude": {
                    "anyOf": [
                      {
                        "maximum": 180,
                        "minimum": -180,
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Estimated Longitude"
                  }
                },
                "required": [
                  "event_id",
                  "type",
                  "status",
                  "zone_id",
                  "country_codes",
                  "detected_at",
                  "coincidence_window_seconds",
                  "required_stations",
                  "station_count",
                  "stations"
                ],
                "title": "EarthquakeCandidate",
                "type": "object",
                "x-product": "Seismik"
              }
            }
          }
        }
      }
    },
    "/v1/events/official-update": {
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Ingest Official Update",
        "operationId": "ingest_official_update_v1_events_official_update_post",
        "parameters": [
          {
            "name": "X-Seismik-Timestamp",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Seismik-Timestamp"
            }
          },
          {
            "name": "X-Seismik-Signature",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Seismik-Signature"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$defs": {
                  "OfficialReport": {
                    "additionalProperties": false,
                    "properties": {
                      "source_id": {
                        "title": "Source Id",
                        "type": "string"
                      },
                      "agency": {
                        "title": "Agency",
                        "type": "string"
                      },
                      "jurisdiction": {
                        "title": "Jurisdiction",
                        "type": "string"
                      },
                      "official_event_id": {
                        "title": "Official Event Id",
                        "type": "string"
                      },
                      "origin_time": {
                        "format": "date-time",
                        "title": "Origin Time",
                        "type": "string"
                      },
                      "updated_at": {
                        "anyOf": [
                          {
                            "format": "date-time",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Updated At"
                      },
                      "latitude": {
                        "maximum": 90,
                        "minimum": -90,
                        "title": "Latitude",
                        "type": "number"
                      },
                      "longitude": {
                        "maximum": 180,
                        "minimum": -180,
                        "title": "Longitude",
                        "type": "number"
                      },
                      "depth_km": {
                        "anyOf": [
                          {
                            "maximum": 800,
                            "minimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Depth Km"
                      },
                      "magnitude": {
                        "anyOf": [
                          {
                            "maximum": 12,
                            "minimum": -2,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Magnitude"
                      },
                      "magnitude_type": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Magnitude Type"
                      },
                      "place": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Place"
                      },
                      "review_status": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Review Status"
                      },
                      "official_url": {
                        "format": "uri",
                        "maxLength": 2083,
                        "minLength": 1,
                        "title": "Official Url",
                        "type": "string"
                      },
                      "attribution": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Attribution"
                      },
                      "tsunami": {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Tsunami"
                      },
                      "felt": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Felt"
                      },
                      "distance_from_station_centroid_km": {
                        "anyOf": [
                          {
                            "minimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Distance From Station Centroid Km"
                      },
                      "origin_time_delta_seconds": {
                        "anyOf": [
                          {
                            "minimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Origin Time Delta Seconds"
                      }
                    },
                    "required": [
                      "source_id",
                      "agency",
                      "jurisdiction",
                      "official_event_id",
                      "origin_time",
                      "latitude",
                      "longitude",
                      "official_url"
                    ],
                    "title": "OfficialReport",
                    "type": "object",
                    "x-product": "Seismik"
                  }
                },
                "additionalProperties": false,
                "properties": {
                  "event_id": {
                    "maxLength": 128,
                    "minLength": 1,
                    "title": "Event Id",
                    "type": "string"
                  },
                  "candidate_event_id": {
                    "maxLength": 128,
                    "minLength": 1,
                    "title": "Candidate Event Id",
                    "type": "string"
                  },
                  "type": {
                    "const": "official_report_update",
                    "title": "Type",
                    "type": "string"
                  },
                  "status": {
                    "const": "official_report_available",
                    "title": "Status",
                    "type": "string"
                  },
                  "matched_at": {
                    "format": "date-time",
                    "title": "Matched At",
                    "type": "string"
                  },
                  "preferred_report": {
                    "$ref": "#/$defs/OfficialReport"
                  },
                  "reports": {
                    "items": {
                      "$ref": "#/$defs/OfficialReport"
                    },
                    "minItems": 1,
                    "title": "Reports",
                    "type": "array"
                  }
                },
                "required": [
                  "event_id",
                  "candidate_event_id",
                  "type",
                  "status",
                  "matched_at",
                  "preferred_report",
                  "reports"
                ],
                "title": "OfficialReportUpdate",
                "type": "object",
                "x-product": "Seismik"
              }
            }
          }
        }
      }
    },
