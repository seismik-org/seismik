        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShakeAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "device_id": {
                    "maxLength": 128,
                    "minLength": 8,
                    "title": "Device Id",
                    "type": "string"
                  },
                  "lat": {
                    "maximum": 90,
                    "minimum": -90,
                    "title": "Lat",
                    "type": "number"
                  },
                  "lon": {
                    "maximum": 180,
                    "minimum": -180,
                    "title": "Lon",
                    "type": "number"
                  },
                  "pga": {
                    "description": "Peak ground acceleration in g",
                    "maximum": 5,
                    "minimum": 0,
                    "title": "Pga",
                    "type": "number"
                  },
                  "timestamp": {
                    "description": "Unix timestamp; milliseconds preferred, seconds accepted for compatibility",
                    "exclusiveMinimum": 0,
                    "title": "Timestamp",
                    "type": "number"
                  }
                },
                "required": [
                  "device_id",
                  "lat",
                  "lon",
                  "pga",
                  "timestamp"
                ],
                "title": "ShakePing",
                "type": "object",
                "x-product": "Seismik"
              }
            }
          }
        }
      }
