SEISMIK_ENVIRONMENT=development
SEISMIK_REDIS_URL=redis://redis:6379/0
SEISMIK_WEBHOOK_HMAC_SECRET=replace-with-at-least-32-random-bytes
SEISMIK_EVENT_MAX_BODY_BYTES=65536
SEISMIK_DEVICE_API_KEY=replace-with-a-random-bootstrap-key
SEISMIK_CROWD_MASTER_SECRET=replace-with-at-least-32-random-bytes
SEISMIK_PUSH_ENABLED=false
SEISMIK_PUSH_MODE=dry_run
# Required only when PUSH_ENABLED=true and PUSH_MODE=testers.
SEISMIK_PUSH_TEST_DEVICE_IDS=[]
SEISMIK_STREAM_MAXLEN=100000
SEISMIK_CONSUMER_BATCH_SIZE=10
SEISMIK_MAX_DELIVERY_ATTEMPTS=5
SEISMIK_INTEGRITY_VERIFICATION_ENABLED=false
SEISMIK_ALLOWED_IOS_APP_IDS=["1:PROJECT:ios:APP_ID"]
SEISMIK_ALLOWED_ANDROID_APP_IDS=["1:PROJECT:android:APP_ID"]
SEISMIK_FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-admin.json
# Public Firebase Web configuration for devs.seismik.org (not the Admin secret).
SEISMIK_FIREBASE_WEB_API_KEY=
SEISMIK_FIREBASE_WEB_AUTH_DOMAIN=seismik-15bbb.firebaseapp.com
SEISMIK_FIREBASE_WEB_PROJECT_ID=seismik-15bbb
SEISMIK_FIREBASE_WEB_APP_ID=
SEISMIK_DEVELOPER_PORTAL_ORIGINS=["https://devs.seismik.org"]
SEISMIK_DEVELOPER_TERMS_VERSION=2026-08-30
SEISMIK_DEVELOPER_MAX_ACTIVE_KEYS=3
SEISMIK_DEVELOPER_FREE_REQUESTS_PER_MINUTE=60
SEISMIK_DEVELOPER_FREE_REQUESTS_PER_DAY=10000
SEISMIK_APNS_KEY_PATH=/run/secrets/AuthKey.p8
SEISMIK_APNS_KEY_ID=
SEISMIK_APNS_TEAM_ID=
SEISMIK_APNS_TOPIC=com.seismik.app
SEISMIK_APNS_USE_SANDBOX=false
