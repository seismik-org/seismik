SEISMIK_ENVIRONMENT=development
SEISMIK_REDIS_URL=redis://redis:6379/0
SEISMIK_WEBHOOK_HMAC_SECRET=replace-with-at-least-32-random-bytes
SEISMIK_DEVICE_API_KEY=replace-with-a-random-bootstrap-key
SEISMIK_CROWD_MASTER_SECRET=replace-with-at-least-32-random-bytes
SEISMIK_PUSH_ENABLED=false
SEISMIK_INTEGRITY_VERIFICATION_ENABLED=false
SEISMIK_ALLOWED_IOS_APP_IDS=["1:PROJECT:ios:APP_ID"]
SEISMIK_ALLOWED_ANDROID_APP_IDS=["1:PROJECT:android:APP_ID"]
SEISMIK_FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-admin.json
SEISMIK_APNS_KEY_PATH=/run/secrets/AuthKey.p8
SEISMIK_APNS_KEY_ID=
SEISMIK_APNS_TEAM_ID=
SEISMIK_APNS_TOPIC=com.seismik.app
SEISMIK_APNS_USE_SANDBOX=false
