// Configuración local de Seismik para iOS. Copia este archivo como
// `Seismik.xcconfig` (ignorado por Git) y completa los valores del equipo.
//
//   cp Flutter/Seismik.xcconfig.example Flutter/Seismik.xcconfig
//
// Los mapas nativos de iOS usan MapKit y no requieren una clave de Google Maps.
// En un .xcconfig `//` inicia un comentario: escrita sin más, la URL queda en
// `https:`. `$()` se expande a nada y conserva las dos barras.
SEISMIK_API_BASE_URL = https:/$()/api.seismik.org

// Equipo de firma para las Critical Alerts y APNs. Debe coincidir con el
// perfil aprobado por Apple para el entitlement de alertas críticas.
DEVELOPMENT_TEAM =
