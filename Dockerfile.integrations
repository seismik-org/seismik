FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/src
WORKDIR /app

RUN useradd --create-home --uid 10001 appuser
COPY requirements-backend.txt ./
RUN pip install --no-cache-dir -r requirements-backend.txt
COPY src ./src
# El mismo proceso alberga el publicador de X y el sondeo de catálogos.
# Ambos cargan este archivo desde el directorio de trabajo al iniciar.
COPY official_sources.json ./official_sources.json
# Nunca publiques una imagen de integraciones sin el catálogo: de él dependen
# tanto los boletines de X como las alertas oficiales por perímetro.
RUN test -s official_sources.json
USER appuser

EXPOSE 8080
CMD ["python", "-m", "dispatcher.integrations"]
