{
	admin off
}

(seismik_security_headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cache-Control "no-store"
	}
}

api.seismik.org {
	import seismik_security_headers
	encode zstd gzip

	request_body {
		max_size 64KB
	}

	reverse_proxy api:8000 {
		health_uri /health/live
		health_interval 30s
		health_timeout 3s
	}
}

www.seismik.org {
	redir https://seismik.org{uri} permanent
}

seismik.org {
	import seismik_security_headers
	header Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
	root * /srv
	@developers path /developers /developers/
	rewrite @developers /developers-public.html
	file_server
}

devs.seismik.org {
	# OAuth/API endpoints for the developer portal are served by FastAPI.
	handle /v1/* {
		reverse_proxy api:8000
	}

	@portal not path /__/auth/*
	header @portal {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self'; img-src 'self' data: https://lh3.googleusercontent.com; connect-src 'self' https://api.seismik.org https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src 'self' https://accounts.google.com https://seismik-15bbb.firebaseapp.com; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
	}

	# Firebase Auth helpers are proxied under the portal domain so OAuth works
	# in browsers that partition or block third-party storage.
	handle /__/auth/* {
		reverse_proxy https://seismik-15bbb.firebaseapp.com {
			header_up Host seismik-15bbb.firebaseapp.com
		}
	}

	root * /srv
	@home path /
	rewrite @home /developers.html
	file_server
}

# This single-level hostname is covered by the existing *.seismik.org certificate.
ifeltit.seismik.org {
    import seismik_security_headers
    header Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    header Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src https://challenges.cloudflare.com; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    request_body {
        max_size 64KB
    }
    handle /v1/reports/* {
        reverse_proxy api:8000 {
            header_up X-Seismik-Client-IP {http.request.remote.host}
            header_up X-Seismik-Origin-Auth {$SEISMIK_EDGE_ORIGIN_SECRET}
        }
    }
    handle {
        root * /srv
        @feltHome path /
        rewrite @feltHome /ifeltit.html
        file_server
    }
}
